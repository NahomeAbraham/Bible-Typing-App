# Port the Express server listens on
PORT=5001

# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bible_data
PG_USER=<your_postgres_user>
PG_PASSWORD=<your_postgres_password>

# Optional: full connection string used by the seed script (falls back to
# PG_* values above if omitted)
DATABASE_URL=postgresql://<your_postgres_user>:<your_postgres_password>@localhost:5432/bible_data
